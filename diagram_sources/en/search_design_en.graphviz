digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", fontname="Arial", fontsize=17];
node [shape=box, style="rounded,filled", fillcolor="#edf5fa", color="#277b9b", fontcolor="#163247", fontname="Arial", fontsize=17, margin="0.18,0.12"];
edge [color="#526e80", fontname="Arial", fontsize=13, arrowsize=0.7];
A [label="Population\nresident* OR student*"];
D [label="Conceptual query\nPopulation AND simulator"];
B [label="Simulator\nhaptic* OR virtual reality"];
E [label="Translate fields and syntax for each database\nSave exact query, limits and date"];
F [label="Check known relevant papers\nRetrieved / indexed in this database"];
G [label="Relevant papers missing?", shape=diamond];
H [label="Investigate reason:\nterm, field, limit or coverage"];
I [label="Execute and export\nControl does not prove completeness"];
A -> D;
B -> D;
D -> E;
E -> F;
F -> G;
G -> H [label="Yes"];
H -> D;
G -> I [label="None in the control set"];
}
