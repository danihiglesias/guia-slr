digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", fontname="Arial", fontsize=17];
node [shape=box, style="rounded,filled", fillcolor="#edf5fa", color="#277b9b", fontcolor="#163247", fontname="Arial", fontsize=17, margin="0.18,0.12"];
edge [color="#526e80", fontname="Arial", fontsize=13, arrowsize=0.7];
A [label="Población\nresident* OR student*"];
D [label="Cadena conceptual\nPoblación AND simulador"];
B [label="Simulador\nhaptic* OR virtual reality"];
E [label="Traducir a campos y sintaxis de cada base\nGuardar cadena exacta, filtros y fecha"];
F [label="Comprobar artículos conocidos\nRecuperados / indexados en esa base"];
G [label="¿Faltan artículos relevantes?", shape=diamond];
H [label="Analizar motivo:\ntérmino, campo, filtro o cobertura"];
I [label="Ejecutar y exportar\nEl control no prueba exhaustividad"];
A -> D;
B -> D;
D -> E;
E -> F;
F -> G;
G -> H [label="Sí"];
H -> D;
G -> I [label="No en el conjunto de control"];
}
