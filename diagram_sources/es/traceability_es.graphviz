digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", fontname="Arial", fontsize=17];
node [shape=box, style="rounded,filled", fillcolor="#edf5fa", color="#277b9b", fontcolor="#163247", fontname="Arial", fontsize=17, margin="0.18,0.12"];
edge [color="#526e80", fontname="Arial", fontsize=13, arrowsize=0.7];
A [label="RQ1: ¿Qué métricas se emplean\npara evaluar el desempeño?"];
B [label="Elegibilidad: residentes o estudiantes;\nsimulador; métrica de desempeño"];
C [label="Extracción: estudio, población, métrica,\njustificación y página de origen"];
D [label="Análisis: agrupar métricas por función;\ncomparar contextos y limitaciones"];
E [label="Figura: población × métrica\nÁrea = número de estudios"];
F [label="Respuesta: tiempo, errores y fuerza;\nno se infiere superioridad clínica"];
A -> B;
B -> C;
C -> D;
D -> E;
E -> F;
}
